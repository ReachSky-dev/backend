# Generowany przez Ansible — nie edytuj ręcznie na serwerze.
# Źródło: deploy/templates/docker-compose.yml.j2
# Regeneruj: ansible-playbook site.yml -l {{ env_name }}
#
# Środowisko: {{ env_name }}
# Routing przez Cloudflare Tunnel:
#   {{ url_frontend }}   → frontend:80
#   {{ url_api }}        → backend:8080
#   {{ url_auth }}       → keycloak:8080
#
# Izolacja: każde środowisko ma własne kontenery, sieć i wolumeny.
#   Projekt compose : {{ compose_project }}
#   Sieć            : reachsky-{{ env_name }}-internal
#   Wolumen bazy    : reachsky-{{ env_name }}-postgres-data
#
# Limity RAM: postgres={{ mem_postgres }} keycloak={{ mem_keycloak }}
#             backend={{ mem_backend }} frontend={{ mem_frontend }} cloudflared={{ mem_cloudflared }}

services:

  # ── Baza danych ──────────────────────────────────────────────────────────────
  # Jeden PostgreSQL obsługuje dwie bazy: reachsky i keycloak.
  # Baza keycloak tworzona przez init/01-keycloak-db.sql przy pierwszym starcie.
  postgres:
    image: postgres:17
    restart: unless-stopped
    environment:
      POSTGRES_USER:     ${DB_USERNAME}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB:       reachsky
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d reachsky"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - internal
    deploy:
      resources:
        limits:
          memory: {{ mem_postgres }}

  # ── Keycloak ─────────────────────────────────────────────────────────────────
  # Tryb start (nie start-dev). Realm importowany z ./keycloak/realm.json
  # przy pierwszym starcie — --import-realm pomija import, jeśli realm istnieje.
  keycloak:
    image: quay.io/keycloak/keycloak:26.0.7
    restart: unless-stopped
    command: ["start", "--import-realm"]
    environment:
      KC_DB:                  postgres
      KC_DB_URL:              jdbc:postgresql://postgres:5432/keycloak
      KC_DB_USERNAME:         ${DB_USERNAME}
      KC_DB_PASSWORD:         ${DB_PASSWORD}
      KC_HOSTNAME:            {{ url_auth }}
      KC_HTTP_ENABLED:        "true"
      KC_PROXY_HEADERS:       xforwarded
      KC_HEALTH_ENABLED:      "true"
      KEYCLOAK_ADMIN:         admin
      KEYCLOAK_ADMIN_PASSWORD: ${KC_ADMIN_PASSWORD}
    volumes:
      - ./keycloak:/opt/keycloak/data/import:ro
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      # Port 9000 = management interface (health/metrics), dostępny zawsze.
      # start_period 120s — pierwsze uruchomienie: migracje DB + import realmu.
      test: ["CMD-SHELL", "curl -fs http://localhost:9000/health/ready || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 6
      start_period: 120s
    networks:
      - internal
    deploy:
      resources:
        limits:
          memory: {{ mem_keycloak }}

  # ── Backend ──────────────────────────────────────────────────────────────────
  # JAVA_TOOL_OPTIONS: JVM respektuje limit kontenera zamiast brać całą pamięć hosta.
  # -XX:MaxRAMPercentage={{ jvm_max_ram_pct }} → max {{ (mem_backend | regex_replace('m','') | int * jvm_max_ram_pct / 100) | int }} MB heap.
  backend:
    image: ${DOCKERHUB_USERNAME}/reachsky-backend:${BACKEND_TAG}
    restart: unless-stopped
    environment:
      SPRING_PROFILES_ACTIVE: prod
      DB_URL:      jdbc:postgresql://postgres:5432/reachsky
      DB_USERNAME: ${DB_USERNAME}
      DB_PASSWORD: ${DB_PASSWORD}
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: {{ url_auth }}/realms/reachsky
      SERVER_FORWARD_HEADERS_STRATEGY: framework
      JAVA_TOOL_OPTIONS: "-XX:MaxRAMPercentage={{ jvm_max_ram_pct }}"
    depends_on:
      postgres:
        condition: service_healthy
      keycloak:
        condition: service_healthy
    networks:
      - internal
    deploy:
      resources:
        limits:
          memory: {{ mem_backend }}

  # ── Frontend ─────────────────────────────────────────────────────────────────
  frontend:
    image: ${DOCKERHUB_USERNAME}/reachsky-frontend:${FRONTEND_TAG}
    restart: unless-stopped
    environment:
      API_URL:       {{ url_api }}
      OIDC_AUTHORITY: {{ url_auth }}/realms/reachsky
      OIDC_CLIENT_ID: ${OIDC_CLIENT_ID}
    networks:
      - internal
    deploy:
      resources:
        limits:
          memory: {{ mem_frontend }}

  # ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
  # Jedyne wyjście na świat — połączenie outbound do Cloudflare.
  # Żaden serwis nie ma sekcji ports:.
  cloudflared:
    image: cloudflare/cloudflared:2024.10.0
    restart: unless-stopped
    command: tunnel --no-autoupdate run
    environment:
      TUNNEL_TOKEN: ${CLOUDFLARE_TUNNEL_TOKEN}
    networks:
      - internal
    deploy:
      resources:
        limits:
          memory: {{ mem_cloudflared }}

networks:
  internal:
    name: "reachsky-{{ env_name }}-internal"
    driver: bridge

volumes:
  postgres_data:
    name: "reachsky-{{ env_name }}-postgres-data"
