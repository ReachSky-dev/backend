# Szablon zmiennych środowiskowych dla compose produkcyjnego.
# Skopiuj jako .env, uzupełnij wartości — nigdy nie commituj .env do repo.
# Wartości tajne powinny trafić przez Ansible Vault, nie przepisywane ręcznie.

# ═══════════════════════════════════════════════════════════
#  TAJNE — generowane/przechowywane w Ansible Vault
# ═══════════════════════════════════════════════════════════

# Hasło użytkownika bazy danych (reachsky — wspólne dla app i KC)
DB_PASSWORD=

# Hasło konta admina Keycloak (panel /admin)
KC_ADMIN_PASSWORD=

# Token tunelu Cloudflare — Zero Trust → Tunnels → reachsky-prod → token
CLOUDFLARE_TUNNEL_TOKEN=

# ═══════════════════════════════════════════════════════════
#  KONFIGURACJA — nie tajne, mogą być w repo w CI/CD
# ═══════════════════════════════════════════════════════════

# Nazwa użytkownika bazy danych
DB_USERNAME=reachsky

# Nazwa użytkownika na Docker Hub (organizacja: reachsky-dev)
DOCKERHUB_USERNAME=reachsky-dev

# Tagi obrazów — aktualizowane przy każdym deploy przez Ansible
# Używaj pełnego SHA commita (40 znaków) — nie "latest"
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Client ID skonfigurowany w Keycloak dla SPA frontendu
OIDC_CLIENT_ID=reachsky-frontend
