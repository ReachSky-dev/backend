  "components" : {
    "schemas" : {
      "OrderResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "auctionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "buyerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "amountInMinorUnits" : {
            "type" : "integer",
            "format" : "int64"
          },
          "currency" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING_PAYMENT", "PAID", "CONFIRMED", "EXPIRED", "CANCELLED" ]
          },
          "paymentDeadline" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CreateListingRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "minLength" : 1
          },
          "description" : {
            "type" : "string"
          },
          "windowStart" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 UTC instant, e.g. 2027-09-01T14:00:00Z"
          },
          "windowEnd" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 UTC instant, e.g. 2027-09-03T10:00:00Z"
          },
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          }
        },
        "required" : [ "title", "windowEnd", "windowStart" ]
      },
      "ListingResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sellerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "windowStart" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 UTC instant"
          },
          "windowEnd" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 UTC instant"
          },
          "capacity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "status" : {
            "type" : "string",
            "$ref" : "#/components/schemas/ListingStatus",
            "enum" : [ "DRAFT", "ACTIVE", "CLOSED", "SOLD", "EXPIRED" ]
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CreateAuctionRequest" : {
        "type" : "object",
        "properties" : {
          "listingId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "ENGLISH", "DUTCH" ]
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "reservePriceAmount" : {
            "type" : "integer",
            "format" : "int64",
            "minimum" : 1
          },
          "currency" : {
            "type" : "string",
            "minLength" : 1
          },
          "startPriceAmount" : {
            "type" : "integer",
            "format" : "int64",
            "minimum" : 1
          },
          "minIncrementAmount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "decrementAmount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "stepSeconds" : {
            "type" : "integer",
            "format" : "int64"
          },
          "floorAmount" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "currency", "endsAt", "listingId", "reservePriceAmount", "startPriceAmount", "startsAt", "type" ]
      },
      "AuctionResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "listingId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sellerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string",
            "$ref" : "#/components/schemas/AuctionType",
            "enum" : [ "ENGLISH", "DUTCH" ]
          },
          "status" : {
            "type" : "string",
            "$ref" : "#/components/schemas/AuctionStatus",
            "enum" : [ "DRAFT", "SCHEDULED", "RUNNING", "SOLD", "RESERVE_NOT_MET", "CANCELLED", "SETTLED" ]
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 UTC instant"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 UTC instant"
          },
          "currentPriceAmount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "currentPriceCurrency" : {
            "type" : "string"
          },
          "decrementAmount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "decrementCurrency" : {
            "type" : "string"
          },
          "stepSeconds" : {
            "type" : "integer",
            "format" : "int64"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
